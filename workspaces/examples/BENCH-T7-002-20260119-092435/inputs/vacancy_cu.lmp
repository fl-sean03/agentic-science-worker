# Cu Vacancy Supercell - Energy Minimization
# For vacancy formation energy calculation
#
# Cu EAM potential: Mishin et al., Phys. Rev. B 63, 224106 (2001)
# Supercell: 4x4x4 with one vacancy = 255 atoms
#
# Vacancy formation energy formula:
# Ef = E(N-1, vacancy) - (N-1)/N × E(N, perfect)
#
# Expected: Ef ~ 1.28 eV (experimental), ~1.0-1.3 eV with EAM

# ============= INITIALIZATION =============
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# ============= CREATE GEOMETRY =============
# FCC Cu lattice, a = 3.615 Å
# Create perfect crystal first
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box

# Mass for Cu
mass            1 63.546

# ============= CREATE VACANCY =============
# Remove the central atom (at approximately 2,2,2 in lattice units)
# For FCC with origin at corner, the center is at (2,2,2) lattice units
# Which is (7.23, 7.23, 7.23) Å
region          vacancy sphere 7.23 7.23 7.23 0.5 units box
delete_atoms    region vacancy

# Verify we removed exactly one atom
variable        natoms equal count(all)
print "Number of atoms after vacancy creation: ${natoms}"

# ============= POTENTIAL =============
pair_style      eam/alloy
pair_coeff      * * Cu_mishin1.eam.alloy Cu

# ============= ENERGY MINIMIZATION =============
# Minimize with tight tolerances for accurate energy
thermo          10
thermo_style    custom step pe ke etotal press pxx pyy pzz lx ly lz

# First minimize with CG - allow atoms to relax around vacancy
min_style       cg
minimize        1.0e-15 1.0e-15 10000 100000

# Relax box dimensions (vacancy causes slight contraction)
fix             1 all box/relax iso 0.0 vmax 0.001
minimize        1.0e-15 1.0e-15 10000 100000
unfix           1

# Final minimization
minimize        1.0e-15 1.0e-15 10000 100000

# ============= OUTPUT =============
variable        pe equal pe
variable        pe_per_atom equal pe/v_natoms
variable        lx equal lx
variable        lat_const equal v_lx/4

print "=========================================="
print "VACANCY CRYSTAL RESULTS"
print "=========================================="
print "Number of atoms: ${natoms}"
print "Total PE: ${pe} eV"
print "PE per atom: ${pe_per_atom} eV/atom"
print "Final box Lx: ${lx} Å"
print "Lattice constant: ${lat_const} Å"
print "=========================================="

# Write data file for reference
write_data      vacancy_cu_minimized.data
