# Perfect Cu Supercell - Energy Minimization
# For vacancy formation energy calculation
#
# Cu EAM potential: Mishin et al., Phys. Rev. B 63, 224106 (2001)
# Expected: Perfect FCC Cu, lattice constant a = 3.615 Å
# Supercell: 4x4x4 = 256 atoms
#
# Vacancy formation energy Ef_exp ~ 1.28 eV (experimental)
# EAM potentials typically give 1.0-1.3 eV

# ============= INITIALIZATION =============
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# ============= CREATE GEOMETRY =============
# FCC Cu lattice, a = 3.615 Å
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box

# Mass for Cu
mass            1 63.546

# ============= POTENTIAL =============
pair_style      eam/alloy
pair_coeff      * * Cu_mishin1.eam.alloy Cu

# ============= ENERGY MINIMIZATION =============
# Minimize with tight tolerances for accurate energy
thermo          10
thermo_style    custom step pe ke etotal press pxx pyy pzz lx ly lz

# First minimize with CG
min_style       cg
minimize        1.0e-15 1.0e-15 10000 100000

# Then relax box dimensions
fix             1 all box/relax iso 0.0 vmax 0.001
minimize        1.0e-15 1.0e-15 10000 100000
unfix           1

# Final minimization
minimize        1.0e-15 1.0e-15 10000 100000

# ============= OUTPUT =============
# Output final configuration and energy
variable        natoms equal count(all)
variable        pe equal pe
variable        pe_per_atom equal pe/v_natoms
variable        lx equal lx
variable        lat_const equal v_lx/4

print "=========================================="
print "PERFECT CRYSTAL RESULTS"
print "=========================================="
print "Number of atoms: ${natoms}"
print "Total PE: ${pe} eV"
print "PE per atom: ${pe_per_atom} eV/atom"
print "Final box Lx: ${lx} Å"
print "Lattice constant: ${lat_const} Å"
print "=========================================="

# Write data file for reference
write_data      perfect_cu_minimized.data
