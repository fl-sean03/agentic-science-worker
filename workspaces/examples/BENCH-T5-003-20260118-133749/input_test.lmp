# LAMMPS Test Input - Short validation run
# Liquid Argon benchmark for testing job script
# Parameters from Rahman, Phys. Rev. 136, A405 (1964)

units           lj
atom_style      atomic
boundary        p p p

# Create a small FCC lattice of Argon
lattice         fcc 0.8442
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

# LJ potential (reduced units)
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# Initial velocities at T* = 1.0
velocity        all create 1.0 87287

# Neighbor list
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press density

# Short NVE equilibration for testing
fix             1 all nve

# Only 1000 steps for testing
timestep        0.005
run             1000

print "Test simulation completed successfully"
