# LAMMPS Production Input - Full simulation
# Liquid Argon MD - Production run (~2 hours on 64 cores)
# Parameters from Rahman, Phys. Rev. 136, A405 (1964)
#
# Expected results:
# - Equilibrium temperature: T* ≈ 1.0
# - Diffusion coefficient: D ≈ 2.4 × 10⁻⁵ cm²/s (at ~94 K)
#
# Source: Rahman, A. (1964). Correlations in the Motion of Atoms
#         in Liquid Argon. Physical Review, 136(2A), A405.

units           lj
atom_style      atomic
boundary        p p p

# Create larger FCC lattice for production (32768 atoms)
lattice         fcc 0.8442
region          box block 0 32 0 32 0 32
create_box      1 box
create_atoms    1 box

# LJ potential (reduced units)
# ε/kB = 119.8 K, σ = 3.405 Å
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# Initial velocities at T* = 1.0
velocity        all create 1.0 87287 dist gaussian

# Neighbor list
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

# ============================================
# Phase 1: Equilibration (NVT)
# ============================================
thermo          1000
thermo_style    custom step temp pe ke etotal press density

# NVT equilibration at T* = 1.0
fix             1 all nvt temp 1.0 1.0 0.5
timestep        0.005

echo log
log             log_equil.lammps

run             50000
unfix           1

# ============================================
# Phase 2: Production (NVE)
# ============================================
echo log
log             log_prod.lammps

# Switch to NVE for production
fix             2 all nve

# Output trajectory for analysis
dump            1 all custom 1000 traj.lammpstrj id type x y z vx vy vz
dump_modify     1 sort id

# Compute MSD for diffusion coefficient
compute         msd all msd com yes
fix             msd_out all ave/time 100 10 1000 c_msd[4] file msd.dat

# Production run (500000 steps = 2500 τ)
thermo          5000
run             500000

# Final output
write_data      final.data

print "============================================"
print "Production simulation completed successfully"
print "============================================"
