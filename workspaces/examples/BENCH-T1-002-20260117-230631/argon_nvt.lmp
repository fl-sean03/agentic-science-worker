# Liquid Argon NVT Equilibration at Triple Point (94.4 K)
# --------------------------------------------------------
# Benchmark Task: BENCH-T1-002
#
# Physical Parameters:
# - LJ parameters from Rahman, Phys. Rev. 136, A405 (1964)
#   ε = 0.238 kcal/mol, σ = 3.405 Å
# - Temperature: 94.4 K (argon triple point)
# - Density: ~1.4 g/cm³ (liquid argon)
# - 256 atoms in FCC lattice (4×4×4 unit cells)
#
# Box calculation:
#   Mass = 256 × 39.948 g/mol = 10227 g/mol
#   Volume = 10227 / (1.4 × 6.022e23) = 1.213e-20 cm³ = 12130 Å³
#   Box length = 12130^(1/3) ≈ 22.98 Å
#   Lattice constant = 22.98/4 ≈ 5.745 Å

# --------------------------------------------------------
# Initialization
# --------------------------------------------------------
units           real
atom_style      atomic
boundary        p p p

# --------------------------------------------------------
# Create FCC lattice with 256 atoms
# --------------------------------------------------------
# Lattice constant for target density
lattice         fcc 5.745

# Create simulation box (4×4×4 unit cells)
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box

# Set mass (argon = 39.948 amu)
mass            1 39.948

# --------------------------------------------------------
# Force field: Lennard-Jones potential
# --------------------------------------------------------
# Rahman (1964) parameters: ε = 0.238 kcal/mol, σ = 3.405 Å
pair_style      lj/cut 10.215   # Cutoff = 3σ = 10.215 Å
pair_coeff      1 1 0.238 3.405

# --------------------------------------------------------
# Initial velocities at target temperature
# --------------------------------------------------------
velocity        all create 94.4 12345 mom yes rot yes dist gaussian

# --------------------------------------------------------
# Neighbor list settings
# --------------------------------------------------------
neighbor        0.5 bin
neigh_modify    every 1 delay 5 check yes

# --------------------------------------------------------
# Thermodynamic output
# --------------------------------------------------------
thermo_style    custom step temp pe ke etotal press density
thermo          100

# Output thermodynamic data to file for analysis
fix             thermo_output all print 100 "$(step) $(temp) $(pe) $(ke) $(etotal) $(press)" &
                file thermo_data.txt screen no title "step temp pe ke etotal press"

# --------------------------------------------------------
# NVT ensemble with Nosé-Hoover thermostat
# --------------------------------------------------------
# Damping parameter: 100 timesteps × 1 fs = 100 fs
fix             nvt_thermostat all nvt temp 94.4 94.4 100.0

# --------------------------------------------------------
# Timestep and run
# --------------------------------------------------------
timestep        1.0    # 1 fs

# Run equilibration for 10,000 steps
run             10000

# --------------------------------------------------------
# Final output
# --------------------------------------------------------
print "Simulation completed"
print "Check thermo_data.txt for temperature analysis"
